{
  "cleanUrls": true,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/study/panel/index.html", "destination": "/study/panel", "permanent": true },
    { "source": "/study/panel/.html", "destination": "/study/panel", "permanent": true },
    { "source": "/study/panel/ingreso/index.html", "destination": "/study/panel/ingreso", "permanent": true },
    { "source": "/study/hub/index.html", "destination": "/study/hub", "permanent": true }
  ],
  "rewrites": [
    { "source": "/panel", "destination": "/study/panel/index.html" },
    { "source": "/study/panel/ingreso", "destination": "/study/panel/ingreso/index.html" },
    { "source": "/study/panel/ingreso/", "destination": "/study/panel/ingreso/index.html" },
    { "source": "/study/panel", "destination": "/study/panel/index.html" },
    { "source": "/study/panel/", "destination": "/study/panel/index.html" },
    { "source": "/study/hub", "destination": "/study/hub/index.html" },
    { "source": "/study/hub/", "destination": "/study/hub/index.html" },
    { "source": "/contacto/chat", "destination": "/contacto/chat/index.html" },
    { "source": "/contacto/chat/", "destination": "/contacto/chat/index.html" },
    { "source": "/contacto/chat/:chatId([0-9]+)", "destination": "/contacto/chat/index.html" },
    { "source": "/:path*", "destination": "/404.html" }
  ]
}
